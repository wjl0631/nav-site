// Prisma schema —— 浮生若梦 · 导航站数据模型
// 数据库：PostgreSQL（推荐 Neon，Pooled 连接 + 直连用于迁移）

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum ArticleStatus {
  DRAFT
  PUBLISHED
}

enum MediaType {
  IMAGE
  VIDEO
  AUDIO
  /// 通用附件（PDF / 压缩包 / Office 文档等），只在正文里以下载链接出现
  FILE
}

/// 后台账号（默认单管理员，role 预留多角色扩展）
model AdminUser {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String    @default("管理员")
  passwordHash String
  role         String    @default("OWNER") // OWNER | EDITOR
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@map("admin_users")
}

/// 导航分类
model Category {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  icon        String? // emoji 或图标 URL
  description String?
  sortOrder   Int      @default(0)
  isVisible   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  links Link[]

  @@index([sortOrder])
  @@map("categories")
}

/// 导航链接
model Link {
  id          String   @id @default(cuid())
  categoryId  String
  title       String
  url         String
  description String?
  iconUrl     String?
  sortOrder   Int      @default(0)
  isVisible   Boolean  @default(true)
  isFeatured  Boolean  @default(false)
  clickCount  Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([categoryId, sortOrder])
  @@index([isFeatured])
  @@map("links")
}

/// 文章
model Article {
  id      String @id @default(cuid())
  title   String
  slug    String @unique
  summary String?
  coverUrl String?

  /// 正文：Tiptap 文档 JSON（唯一数据源，便于回填编辑器）
  content Json
  /// 正文：服务端清洗后的 HTML（前台直出，避免加载编辑器运行时）
  contentHtml String @db.Text

  status      ArticleStatus @default(DRAFT)
  publishedAt DateTime?
  isFeatured  Boolean       @default(false)
  viewCount   Int           @default(0)
  tags        String[]      @default([])

  seoTitle       String?
  seoDescription String?

  authorId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, publishedAt])
  @@index([isFeatured])
  @@map("articles")
}

/// 媒体库（图片 / 视频 / 音频）
model Media {
  id        String    @id @default(cuid())
  url       String
  type      MediaType
  filename  String
  mimeType  String
  size      Int
  width     Int?
  height    Int?
  createdAt DateTime  @default(now())

  @@index([type, createdAt])
  @@map("media")
}
