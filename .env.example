# ===== 数据库（Neon / Supabase 均为 PostgreSQL）=====
# Neon 控制台 → 项目 → 顶部「Connect」→ 勾选 Connection pooling 复制上面的串，
# 取消勾选后复制下面的直连串。两条串只有主机名差一个 -pooler。
#
# 运行时用 Pooled（带 -pooler，避免 Serverless 打死连接池）
DATABASE_URL="postgresql://neondb_owner:npg_xxxx@ep-cool-darkness-a1b2c3d4-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require&connect_timeout=30"
# 迁移 / db push 用 Direct（无 -pooler）
DIRECT_URL="postgresql://neondb_owner:npg_xxxx@ep-cool-darkness-a1b2c3d4.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require&connect_timeout=30"
#
# 说明：
# - connect_timeout=30：Neon 计算实例会 scale-to-zero，冷启动慢时避免 Prisma 报 P1001
# - channel_binding=require：新版 Neon 默认带；若 Prisma 报 P1013 连接串不合法，删掉这一段即可
# - 注意：Neon 的 AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY / AWS_ENDPOINT_URL_S3
#   是「对象存储」的 S3 凭据，与本项目的数据库连接无关，不要填到这里

# ===== 鉴权（openssl rand -base64 32 生成）=====
AUTH_SECRET="replace-with-a-long-random-string"
AUTH_TRUST_HOST="true"

# ===== 初始管理员（仅 seed 使用，密码为明文，写入时自动 bcrypt）=====
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="ChangeMe123!"

# ===== 站点信息 =====
NEXT_PUBLIC_SITE_NAME="浮生若梦"
NEXT_PUBLIC_SITE_DESCRIPTION="精选优质网站与深度文章，一页直达"
NEXT_PUBLIC_SITE_URL="https://your-domain.vercel.app"

# ===== 媒体存储（Vercel 控制台 Storage → Blob 创建后自动注入）=====
# 当前实现使用 Vercel Blob，无需 Neon 的 S3 凭据
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxx"
# 媒体中心的「存储用量」以此为上限基准（单位 GB）。Hobby 免费额度为 1 GB/月，
# 升级 Pro 后按实际额度调整；不填默认 1。
BLOB_QUOTA_GB="1"
